# ---------------------------------------------------------------------------
# Local development configuration.
#
# Copy to `.env.local` and adjust. NOTHING in this file is a secret: every
# VITE_* value is inlined into the client bundle and is publicly visible.
#
# The admin portal's GitHub token is NEVER configured here. It is entered by
# the editor at /admin at sign-in time and stays in their browser. Do not add a
# token to any .env file — it would be published with the site.
# ---------------------------------------------------------------------------

# Repository the admin portal commits content to.
VITE_GITHUB_OWNER=VidvathamaIIITH
VITE_GITHUB_REPO=VidvathamaIIITH.github.io
VITE_GITHUB_BRANCH=main

# Deployment base path.
#   "/"                      for a user site  (VidvathamaIIITH.github.io)
#   "/vidvathama-research/"  for a project site
VITE_BASE_PATH=/

# Canonical site URL, used for sitemap and canonical tags at build time.
VITE_SITE_URL=https://vidvathamaiiith.github.io
